# Copy to backend/.env and fill in. Never commit .env
DATABASE_URL=mysql+pymysql://pms_user:change_me_pass@127.0.0.1:3306/pms
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=20
SEED_PASSWORD=Demo@12345

# Local overrides for shared root .env email settings.
# Empty key logs emails locally. Never commit a real key.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
APP_URL=http://localhost:5173
