# Used by docker-compose.dev.yml (MySQL only) and docker-compose.yml (full stack). Copy to .env, never commit .env
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=pms
MYSQL_USER=pms_user
MYSQL_PASSWORD=change_me_pass

# Used by docker-compose.yml only
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_long_random_string
CORS_ORIGINS=http://localhost:8080
# Set by CI on deploy (GHCR image owner in lowercase, and the image tag = git commit SHA)
GHCR_OWNER=local
IMAGE_TAG=latest

# Email (Resend). Leave RESEND_API_KEY empty to just log emails to the console.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
# Sandbox sender only delivers to the Resend account owner; verify a sender domain for other recipients.
APP_URL=http://localhost:8080
